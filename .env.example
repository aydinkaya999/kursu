# Defaults for local development. Compose publishes PostgreSQL on loopback.
POSTGRES_DB=kursu
POSTGRES_USER=kursu
POSTGRES_PASSWORD=kursu_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://kursu:kursu_local@127.0.0.1:5432/kursu
APP_ENV=development
BUSINESS_TIMEZONE=Europe/Istanbul
APP_ORIGIN=http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:8000

# Reserved for the account milestone. Only EXPO_PUBLIC_* is bundled by Expo.
JWT_SECRET=
EMAIL_SENDER=
GOOGLE_CLIENT_IDS=
APPLE_AUDIENCES=
