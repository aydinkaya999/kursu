{
  "expo": {
    "name": "Kürsü",
    "slug": "kursu",
    "scheme": "kursu",
    "version": "0.1.0",
    "platforms": ["ios", "android", "web"],
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Sorunun fotoğrafını çekmek için kamera erişimine izin ver.",
          "photosPermission": "Çözülecek sorunun fotoğrafını seçmek için fotoğraflarına erişime izin ver.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "lang": "tr",
      "output": "single"
    }
  }
}
